public static int getSizeIterative(FileNode root) {
    Stack<FileNode> stack = new Stack<>();
    stack.push(root);

    int total = 0;

    while (!stack.isEmpty()) {
        FileNode current = stack.pop();

        if (current.isFile) {
            total += current.size;
        } else {
            for (FileNode child : current.children) {
                stack.push(child);
            }
        }
    }

    return total;
}